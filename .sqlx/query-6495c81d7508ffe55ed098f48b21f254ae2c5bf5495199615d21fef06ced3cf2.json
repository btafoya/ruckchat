  "query": "SELECT mf.message_id, f.id, f.organization_id, f.uploaded_by, f.file_name, f.mime_type, f.size_bytes, f.storage_path, f.thumbnail_path, f.created_at\n             FROM message_files mf\n             JOIN files f ON f.id = mf.file_id\n             WHERE mf.message_id = ANY($1)\n             ORDER BY f.created_at",
